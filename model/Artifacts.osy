// The artifact, its versions and comments, and the one way an artifact is published.
namespace Osysharp.Artifacts;

using Osysharp.Storage;

/// ⭐ WHO SEES A SUBJECT'S ARTIFACTS — every version and every comment on them. `subjectType` is the app's own name for
/// the row (`"DesignItem"`), `subjectId` its id: `policy ReadsArtifactsOf(string subjectType, Guid subjectId) =>
/// subjectType == "DesignItem" && DesignItem.Any(d => d.Id == subjectId && d.Team.Members.Any(m => m == user));`.
/// Nobody, until the app says.
virtual policy ReadsArtifactsOf(string subjectType, Guid subjectId) => false;

/// ⭐ WHO PUBLISHES ON A SUBJECT — a new artifact, or a new version of one. Nobody, until the app says.
virtual policy WritesArtifactsOf(string subjectType, Guid subjectId) => false;

/// ⭐ WHO COMMENTS ON A SUBJECT'S ARTIFACTS, and marks a comment resolved. Whoever reads them, until the app says.
virtual policy CommentsOnArtifactsOf(string subjectType, Guid subjectId) => ReadsArtifactsOf(subjectType, subjectId);

/// What an artifact is — fixed by the type it was first published as.
public enum ArtifactKind { Html, Image, Pdf, Markdown, Text, Json }

/// The kit's settings. An organisation's policy may bound both for every app it runs: lower the cap, and forbid HTML
/// prototypes (pages that run their own script, sandboxed) altogether. Nothing here is secret, so pages read it directly.
[AppSetting("Artifacts", Browser = true)]
public class ArtifactsSetup {
  /// The largest one version may be, in bytes — never more than 25 MB.
  [OrgPolicy(OrgPolicyMode.Range, Name = "Artifact version size (bytes)", Area = OrgPolicyArea.Agents)] public long MaxBytes = 26214400;
  /// Whether an HTML prototype may be published at all.
  [OrgPolicy(OrgPolicyMode.Lock, Name = "HTML prototypes may be published", Area = OrgPolicyArea.Agents)] public bool AllowPrototypes = true;
  /// The viewer base artifacts are shown from — a domain of their own, never the app's site (`osyrin.dev`): each artifact
  /// is then served at `https://<artifact>-<placement>.<base>/…`, an origin of its own. Empty: the app's own sandboxed
  /// route. Host name and optional port, no scheme. A base that shares the app's site is refused (the app's route is used).
  [OrgPolicy(OrgPolicyMode.Lock, Name = "Artifact viewer base", Area = OrgPolicyArea.Agents)] public string ViewerBase = "";
}

/// One thing made for review, on one row of the app. Its file's versions are its versions: publishing under the same
/// name on the same subject again supersedes the file, and the old versions are kept (`ArtifactVersions`).
public entity Artifact {
  [Required, Immutable, MaxLength(120), Index] string SubjectType;
  [Required, Immutable, Index] Guid SubjectId;
  /// Its name on the subject — `index.html`, `flow.png`. One artifact per name per subject.
  [Required, Immutable, MaxLength(200)] string Name;
  [Immutable] ArtifactKind Kind = ArtifactKind.Text;
  [Required, Immutable, MaxLength(100)] string ContentType;
  /// The file: its current content, and every version it has had.
  [Required, Immutable, Attachment] FileAsset File;
  /// The work handed outside that made it, when one did (`Osysharp.Agents`' `AgentDelegation`, by id).
  Guid? Delegation;
  [CreatedBy] Guid? CreatedBy;
  [CreatedAt] DateTime CreatedAt;
  DateTime UpdatedAt = DateTime.UtcNow;

  security {
    allow read when IsAuthenticated where ReadsArtifactsOf(SubjectType, SubjectId);
    allow create, update when IsAuthenticated where WritesArtifactsOf(SubjectType, SubjectId);
    deny create, update except via PublishArtifact;
    deny delete;
  }
}

/// One file of a bundled artifact's version beside its entry page — a script, a stylesheet, a picture, a font — at a
/// relative path the entry loads it by (`app.js`, `img/logo.png`). It belongs to one version; a new version brings its own.
public entity ArtifactAsset {
  [Required, Immutable, Index] Artifact Artifact;
  /// The artifact's version it is part of.
  [Required, Immutable] int Version;
  /// Its path beside the entry: relative, `/`-separated, no `..`.
  [Required, Immutable, MaxLength(200)] string Path;
  [Required, Immutable, MaxLength(100)] string ContentType;
  [Required, Immutable, Attachment] FileAsset File;

  security {
    allow read when IsAuthenticated where ReadsArtifactsOf(Artifact.SubjectType, Artifact.SubjectId);
    allow create when IsAuthenticated where WritesArtifactsOf(Artifact.SubjectType, Artifact.SubjectId);
    deny create except via PublishArtifactBundle;
    deny update;
    deny delete;
  }
}

/// One file handed to `PublishArtifactBundle`: where it sits beside the entry, its type, its bytes.
public class ArtifactFile {
  public string Path = "";
  public string ContentType = "";
  public byte[] Bytes;
}

/// A comment on one version of an artifact — at a point of it when `X`/`Y` are given (fractions of the frame, 0–1).
public entity ArtifactComment {
  [Required, Immutable, Index] Artifact Artifact;
  /// The version it is about: a comment stays with the version it was written on.
  [Required, Immutable] int Version;
  [Required, Immutable, MaxLength(4000), Classification(Personal.Content)] string Text;
  [Immutable] decimal? X;
  [Immutable] decimal? Y;
  bool Resolved = false;
  [CreatedBy] Guid? Author;
  [CreatedAt] DateTime At;

  security {
    allow read when IsAuthenticated where ReadsArtifactsOf(Artifact.SubjectType, Artifact.SubjectId);
    allow create, update when IsAuthenticated where CommentsOnArtifactsOf(Artifact.SubjectType, Artifact.SubjectId);
    deny create except via CommentOnArtifact;
    deny update except via ResolveArtifactComment;
    deny delete;
  }
}

/// The types an artifact may be.
public List<string> ArtifactTypes() {
  return ["text/html", "image/png", "image/jpeg", "image/webp", "image/gif", "image/svg+xml", "application/pdf",
          "text/markdown", "text/plain", "application/json"];
}

/// ⭐ PUBLISH AN ARTIFACT ON A SUBJECT — or, under a name it already has there, a new version of it; the old ones are
/// kept. The type must be one of `ArtifactTypes()` and the bytes what the type says (a "picture" that is really HTML is
/// refused); a version is at most `ArtifactsSetup.MaxBytes` (25 MB). A new version keeps the artifact's type.
[Server, Authorize(IsAuthenticated)]
public Artifact PublishArtifact(string subjectType, Guid subjectId, string name, string contentType, byte[] bytes,
                                Guid? delegation = null) {
  var shown = name.Trim();
  if (shown == "" || shown.Length > 200 || shown.Contains("/") || shown.Contains("\\") || shown.Contains("\n") || shown.StartsWith(".")) {
    throw new ValidationException("An artifact is named by a plain name of at most 200 characters: `index.html`.");
  }
  if (subjectType.Trim() == "" || subjectType.Length > 120) { throw new ValidationException("Say what the artifact is on: the subject's type, in at most 120 characters."); }
  var type = contentType.Trim().ToLower();
  if (!ArtifactTypes().Contains(type)) {
    throw new ValidationException($"{type} is not a type an artifact may be: " + string.Join(", ", ArtifactTypes()) + ".");
  }
  var setup = App.Setting<ArtifactsSetup>();
  if (type == "text/html" && !setup.AllowPrototypes) {
    throw new ValidationException("Your organization's policy does not allow HTML prototypes to be published.");
  }
  var cap = setup.MaxBytes < 26214400 ? setup.MaxBytes : 26214400;
  if (bytes.Length == 0) { throw new ValidationException("An artifact holds something."); }
  if (bytes.Length > cap) { throw new ValidationException($"An artifact version is at most {cap / 1048576} MB."); }
  var lie = ArtifactBytesLie(type, bytes);
  if (lie != "") { throw new ValidationException(lie); }

  var kept = Artifact.FirstOrDefault(a => a.SubjectType == subjectType && a.SubjectId == subjectId && a.Name == shown);
  if (kept != null) {
    if (kept!.ContentType != type) {
      throw new ValidationException($"{shown} is {kept!.ContentType}; a new version keeps its type. Publish {type} under a name of its own.");
    }
    File.Supersede(kept!.File, bytes);
    kept!.UpdatedAt = DateTime.UtcNow;
    if (delegation != null) { kept!.Delegation = delegation; }
    return kept!;
  }
  return new Artifact {
    SubjectType = subjectType, SubjectId = subjectId, Name = shown, Kind = ArtifactKindOf(type), ContentType = type,
    File = File.Create(shown, type, bytes), Delegation = delegation, UpdatedAt = DateTime.UtcNow,
  };
}

/// The types a bundle's file may be. No JSON: an artifact may fetch nothing (`connect-src 'none'`), so nothing could load it.
public List<string> ArtifactAssetTypes() {
  return ["text/html", "text/css", "text/javascript", "image/png", "image/jpeg", "image/webp", "image/gif", "image/svg+xml",
          "font/woff", "font/woff2"];
}

/// ⭐ PUBLISH A BUNDLED PROTOTYPE — an entry page and the files it loads by relative path (`app.js`, `css/site.css`,
/// `img/logo.png`), as one version: a new version of the artifact `name` (an HTML page) on the subject, its files kept
/// with that version. Paths are relative, `/`-separated, made of letters, digits, `.`, `_` and `-`, at most 8 deep and
/// 200 long, never `..`; at most 300 files; types from `ArtifactAssetTypes()`, bytes what the type says; the whole bundle
/// at most `ArtifactsSetup.MaxBytes`. The entry must load its files by RELATIVE address (`./app.js`, not `/app.js`).
[Server, Authorize(IsAuthenticated)]
public Artifact PublishArtifactBundle(string subjectType, Guid subjectId, string name, byte[] entry, List<ArtifactFile> files,
                                      Guid? delegation = null) {
  if (files.Count > 300) { throw new ValidationException("A bundle holds at most 300 files beside its entry."); }
  var setup = App.Setting<ArtifactsSetup>();
  var cap = setup.MaxBytes < 26214400 ? setup.MaxBytes : 26214400;
  long total = entry.Length;
  var seen = new List<string>();
  foreach (var f in files) {
    var path = f.Path.Trim();
    var refusal = ArtifactPathRefusal(path);
    if (refusal != "") { throw new ValidationException(refusal); }
    if (path == name.Trim() || seen.Contains(path)) { throw new ValidationException($"{path} is in the bundle twice."); }
    seen.Add(path);
    var type = f.ContentType.Trim().ToLower();
    if (type == "application/javascript") { type = "text/javascript"; }
    if (!ArtifactAssetTypes().Contains(type)) {
      throw new ValidationException($"{path}: {type} is not a type a bundle's file may be: " + string.Join(", ", ArtifactAssetTypes()) + ".");
    }
    if (f.Bytes.Length == 0) { throw new ValidationException($"{path} is empty."); }
    var lie = ArtifactBytesLie(type, f.Bytes);
    if (lie != "") { throw new ValidationException($"{path}: {lie}"); }
    total = total + f.Bytes.Length;
  }
  if (total > cap) { throw new ValidationException($"A bundle is at most {cap / 1048576} MB, its entry and files together."); }

  var kept = Artifact.FirstOrDefault(a => a.SubjectType == subjectType && a.SubjectId == subjectId && a.Name == name.Trim());
  var version = kept == null ? 1 : ArtifactVersions(kept!).Last().Version + 1;
  var artifact = PublishArtifact(subjectType, subjectId, name, "text/html", entry, delegation);
  foreach (var f in files) {
    var path = f.Path.Trim();
    var type = f.ContentType.Trim().ToLower();
    if (type == "application/javascript") { type = "text/javascript"; }
    new ArtifactAsset { Artifact = artifact, Version = version, Path = path, ContentType = type,
                        File = File.Create(ArtifactLeaf(path), type, f.Bytes) };
  }
  return artifact;
}

/// The files of one version of a bundled artifact, by path. Empty for a single page.
public List<ArtifactAsset> ArtifactAssets(Artifact artifact, int version) {
  return ArtifactAsset.Where(a => a.Artifact == artifact && a.Version == version).OrderBy(a => a.Path).ToList();
}

/// What is wrong with a bundle file's path — or "".
string ArtifactPathRefusal(string path) {
  if (path == "" || path.Length > 200) { return "A bundle's file has a relative path of at most 200 characters: `img/logo.png`."; }
  var parts = path.Split("/");
  if (parts.Length > 8) { return $"{path} is more than 8 folders deep."; }
  foreach (var part in parts) {
    if (part == "" || part.StartsWith(".")) { return $"{path} is not a plain relative path: no empty, `.` or `..` parts, and nothing hidden."; }
    for (var i = 0; i < part.Length; i++) {
      var c = part.Substring(i, 1);
      if (!("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-".Contains(c))) {
        return $"{path}: a path is made of letters, digits, `.`, `_`, `-` and `/`.";
      }
    }
  }
  return "";
}

/// The last part of a path — the stored file's name.
string ArtifactLeaf(string path) {
  var parts = path.Split("/");
  return parts[parts.Length - 1];
}

/// Every version an artifact has had, the first first — the current one included.
public List<FileVersion> ArtifactVersions(Artifact artifact) {
  return artifact.File.Versions.OrderBy(v => v.Version).ToList();
}

/// ⭐ COMMENT ON ONE VERSION OF AN ARTIFACT — at a point of it when `x` and `y` are given, each a fraction of the frame.
[Server, Authorize(IsAuthenticated)]
public ArtifactComment CommentOnArtifact(Artifact artifact, int version, string text, decimal? x = null, decimal? y = null) {
  var said = text.Trim();
  if (said == "") { throw new ValidationException("Write something first."); }
  if (said.Length > 4000) { throw new ValidationException("A comment is at most 4000 characters."); }
  if (!artifact.File.Versions.Any(v => v.Version == version)) { throw new ValidationException($"{artifact.Name} has no version {version}."); }
  if ((x == null) != (y == null) || (x != null && (x! < 0 || x! > 1 || y! < 0 || y! > 1))) {
    throw new ValidationException("A point is given as both x and y, each between 0 and 1.");
  }
  return new ArtifactComment { Artifact = artifact, Version = version, Text = said, X = x, Y = y };
}

/// Mark a comment resolved — or open again.
[Server, Authorize(IsAuthenticated)]
public void ResolveArtifactComment(ArtifactComment comment, bool resolved = true) {
  comment.Resolved = resolved;
}

ArtifactKind ArtifactKindOf(string type) {
  if (type == "text/html") { return ArtifactKind.Html; }
  if (type.StartsWith("image/")) { return ArtifactKind.Image; }
  if (type == "application/pdf") { return ArtifactKind.Pdf; }
  if (type == "text/markdown") { return ArtifactKind.Markdown; }
  if (type == "application/json") { return ArtifactKind.Json; }
  return ArtifactKind.Text;
}

/// What is wrong with an artifact's bytes for the type it says it is — or "": they are what it says.
string ArtifactBytesLie(string contentType, byte[] b) {
  var magic = ArtifactMagic(b);
  if (contentType == "image/png" || contentType == "image/jpeg" || contentType == "image/webp" || contentType == "image/gif"
      || contentType == "application/pdf" || contentType == "font/woff" || contentType == "font/woff2") {
    return magic == contentType ? "" : $"It is declared {contentType}, and its bytes are not.";
  }
  // Every other allowed type is text: never a binary format, and UTF-8 throughout.
  if (magic != "" || !ArtifactIsText(b)) { return $"It is declared {contentType}, and its bytes are not text."; }
  if (contentType == "image/svg+xml" && !Encoding.UTF8.GetString(b).Contains("<svg")) { return "It is declared an SVG picture, and holds none."; }
  return "";
}

/// The binary format the bytes begin as, by their first bytes — or "".
string ArtifactMagic(byte[] b) {
  if (b.Length >= 8 && b[0] == 137 && b[1] == 80 && b[2] == 78 && b[3] == 71) { return "image/png"; }
  if (b.Length >= 3 && b[0] == 255 && b[1] == 216 && b[2] == 255) { return "image/jpeg"; }
  if (b.Length >= 6 && b[0] == 71 && b[1] == 73 && b[2] == 70 && b[3] == 56) { return "image/gif"; }
  if (b.Length >= 12 && b[0] == 82 && b[1] == 73 && b[2] == 70 && b[3] == 70 && b[8] == 87 && b[9] == 69 && b[10] == 66 && b[11] == 80) {
    return "image/webp";
  }
  if (b.Length >= 5 && b[0] == 37 && b[1] == 80 && b[2] == 68 && b[3] == 70 && b[4] == 45) { return "application/pdf"; }
  if (b.Length >= 4 && b[0] == 80 && b[1] == 75 && (b[2] == 3 || b[2] == 5)) { return "application/zip"; }
  if (b.Length >= 4 && b[0] == 119 && b[1] == 79 && b[2] == 70 && b[3] == 70) { return "font/woff"; }
  if (b.Length >= 4 && b[0] == 119 && b[1] == 79 && b[2] == 70 && b[3] == 50) { return "font/woff2"; }
  return "";
}

/// Text: no NUL, and the whole reads as UTF-8 without a replacement character.
bool ArtifactIsText(byte[] b) {
  for (var i = 0; i < b.Length; i++) { if (b[i] == 0) { return false; } }
  return !Encoding.UTF8.GetString(b).Contains("�");
}
