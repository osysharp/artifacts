// The viewer.
namespace Osysharp.Artifacts;

using Osysharp.Storage;
using Osysharp.Ui;

/// ⭐ ONE VERSION OF AN ARTIFACT, shown in a sandboxed frame: an HTML prototype runs its own script in an origin of its
/// own — never the app's — and reaches nothing; a picture, a PDF or a note is shown with no script at all. Its address
/// is signed for the reader by the platform after their own read of the artifact; somebody who may not see it gets an
/// empty frame. A bundled prototype's files (`ArtifactAsset.PublishBundle`) load beside it by their relative paths.
///
/// With a viewer base (`ArtifactsSetup.ViewerBase`, or `viewer:` here) the artifact is served from an origin of its own,
/// `https://<artifact>-<placement>.<base>/…` — never the app's site, never another artifact's origin.
///
/// SPOT MODE (`spots: true`, an HTML artifact): while `onSpot` is bound, a click in the frame picks a SPOT instead of
/// pressing what is under it, and `onSpot` runs with the `ArtifactSpot` — the nearest element with a `data-spot` key,
/// else an `id`, else a heading, else `page` — and the point within it. `pins` are drawn in the frame at their spots,
/// labelled with at most 3 characters (a thread's number: the artifact's own script can read what is drawn in it), and
/// `focus` scrolls the frame to a spot and rings it. The sandbox is the same as without it.
///
///     ArtifactView(artifact.Versions().Last(), h: 720);
///     ArtifactView(version, spots: true, pins: pins, focus: open, onSpot: commenting ? Picked : null);
public component ArtifactView(FileVersion version, int h = 640, string? viewer = null, bool spots = false,
                              ArtifactPin[]? pins = null, string focus = "", Action<ArtifactSpot>? onSpot = null) {
  render {
    ArtifactFrame(version: version.Id, title: version.Name + ", version " + version.Version, h: h,
                  viewer: viewer ?? App.Setting<ArtifactsSetup>().ViewerBase,
                  spots: spots, pins: pins, focus: focus, onSpot: onSpot);
  }
}
